# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm AS builder
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    apt-get update && apt-get install -y --no-install-recommends git g++ cmake make ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY douzero/requirements-marvel.txt /app/douzero/
COPY scripts/setup-marvel.sh /app/scripts/
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca; fi; \
    python -m pip install 'torch>=2.6,<3' --index-url https://download.pytorch.org/whl/cpu && bash scripts/setup-marvel.sh

FROM python:3.12-slim-bookworm
COPY --chown=65532:65532 --from=builder /usr/local /usr/local
COPY --chown=65532:65532 --from=builder /app/douzero/vendor/doudizhu /opt/doudizhu
WORKDIR /app
COPY --chown=65532:65532 douzero/src ./src
COPY --chown=65532:65532 douzero/server.py .
ENV AI_BACKEND=marvel MARVEL_ROOT=/opt/doudizhu DOUZERO_MODELS=/models PORT=2021 TORCH_NUM_THREADS=2
USER 65532:65532
EXPOSE 2021
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:2021/health')"
CMD ["python", "-u", "server.py"]
